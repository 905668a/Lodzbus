# Frontend API base URL
VITE_API_URL=https://lodz-bus-backend.onrender.com

# Optional: if you later want frontend-side Google integrations
VITE_GOOGLE_MAPS_API_KEY=your_google_api_key_here

# Backend uses backend-lodz/.env for server-side Google Maps walking calculations
# Set GOOGLE_MAPS_API_KEY there with a valid key to enable real Google walking times.
